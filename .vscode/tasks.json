{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "cpp",
                "-B", "cpp/build",
                "-DCMAKE_BUILD_TYPE=Debug",
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "cpp/build"
            ],
            "dependsOn": "CMake Configure",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Build",
            "type": "shell",
            "command": "./cpp/build/main",
            "problemMatcher": []
        },
        {
            "label": "Build And Run",
            "dependsOn": [
                "CMake Build",
                "Run Build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
