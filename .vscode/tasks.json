{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=Debug",
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", 
                "build",
                "--target",
                "main"
            ],
            "dependsOn": "CMake Configure",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Build",
            "type": "shell",
            "command": "./build/main",
            "problemMatcher": []
        },
        {
            "label": "Build And Run",
            "dependsOn": [
                "CMake Build",
                "Run Build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "tests"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure"
            ],
            "dependsOn": "Build Tests",
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests in Current File",
            "type": "shell",
            "command": "${workspaceFolder}/build/tests",
            "args": [
                "\"[${fileBasenameNoExtension}]\""
            ],
            "dependsOn": "Build Tests",
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
