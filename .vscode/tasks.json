{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run Active C++ File",
            "type": "shell",
            "command": "clang++ -std=c++23 -Wall -Wextra -pedantic *.cpp -o main && ./main",
            "options": {
                "cwd": "${workspaceFolder}/cpp"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}