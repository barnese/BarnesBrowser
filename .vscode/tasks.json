{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++23",
                "-g",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "*.cpp",
                "-o",
                "build/main",
                "-I/opt/homebrew/opt/openssl@3/include",
                "-L/opt/homebrew/opt/openssl@3/lib",
                "-I/opt/homebrew/opt/qt/lib/QtWidgets.framework/Headers",
                "-I/opt/homebrew/opt/qt/lib/QtGui.framework/Headers",
                "-I/opt/homebrew/opt/qt/lib/QtCore.framework/Headers",
                "-F/opt/homebrew/opt/qt/lib",
                "-lssl",
                "-lcrypto",
                "-framework",
                "QtWidgets",
                "-framework",
                "QtGui",
                "-framework",
                "QtCore"
            ],
            "options": {
                "cwd": "${workspaceFolder}/cpp"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Build",
            "type": "shell",
            "command": "./cpp/build/main",
            "problemMatcher": []
        },
        {
            "label": "Build And Run",
            "dependsOn": [
                "Build Debug",
                "Run Build"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}